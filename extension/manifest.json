{
  "manifest_version": 3,
  "name": "NudeNyang Web Translator",
  "version": "0.1.9",
  "description": "NudeNyang Windows 앱의 번역 엔진으로 웹페이지 문단을 원래 레이아웃 그대로 번역합니다.",
  "key": "",
  "permissions": ["nativeMessaging", "storage", "activeTab"],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/paw-16.png",
    "32": "icons/paw-32.png",
    "48": "icons/paw-48.png",
    "128": "icons/paw-128.png"
  },
  "action": {
    "default_title": "NudeNyang Web Translator",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/paw-16.png",
      "32": "icons/paw-32.png",
      "48": "icons/paw-48.png",
      "128": "icons/paw-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*",
        "https://booth.pm/*",
        "https://*.booth.pm/*",
        "https://x.com/*",
        "https://twitter.com/*",
        "https://www.google.com/*",
        "https://www.google.co.kr/*",
        "https://www.google.co.jp/*",
        "https://www.youtube.com/*"
      ],
      "js": ["site-adapters.js", "content-helpers.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
