{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "0.1.23",
  "description": "__MSG_extensionDescription__",
  "default_locale": "en",
  "key": "",
  "permissions": ["nativeMessaging", "storage", "activeTab"],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/paw-16.png",
    "32": "icons/paw-32.png",
    "48": "icons/paw-256.png",
    "60": "icons/paw-60.png",
    "72": "icons/paw-72.png",
    "96": "icons/paw-96.png",
    "128": "icons/paw-128.png",
    "160": "icons/paw-160.png",
    "192": "icons/paw-192.png",
    "256": "icons/paw-256.png"
  },
  "action": {
    "default_title": "__MSG_extensionName__",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/paw-16.png",
      "20": "icons/paw-20.png",
      "24": "icons/paw-24.png",
      "32": "icons/paw-32.png"
    }
  },
  "commands": {
    "toggle-page-translation": {
      "suggested_key": {
        "windows": "Ctrl+Shift+L"
      },
      "description": "__MSG_togglePageTranslation__"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": ["site-adapters.js", "content-helpers.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
