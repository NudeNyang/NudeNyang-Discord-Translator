{
  "manifest_version": 3,
  "name": "NudeNyang Web Translator",
  "version": "0.1.18",
  "description": "NudeNyang Windows 앱의 번역 엔진으로 웹페이지 문단을 원래 레이아웃 그대로 번역합니다.",
  "permissions": ["nativeMessaging", "storage", "activeTab"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "browser_specific_settings": {
    "gecko": {
      "id": "web-translator@nudenyang.github.io",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["websiteContent"]
      }
    }
  },
  "background": {
    "scripts": ["native-client.js", "background.js"]
  },
  "icons": {
    "16": "icons/paw-16.png",
    "32": "icons/paw-32.png",
    "48": "icons/paw-48.png",
    "60": "icons/paw-60.png",
    "72": "icons/paw-72.png",
    "96": "icons/paw-96.png",
    "128": "icons/paw-128.png",
    "160": "icons/paw-160.png",
    "192": "icons/paw-192.png",
    "256": "icons/paw-256.png"
  },
  "action": {
    "default_title": "NudeNyang Web Translator",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/paw-16.png",
      "20": "icons/paw-20.png",
      "24": "icons/paw-24.png",
      "32": "icons/paw-32.png"
    }
  },
  "commands": {
    "toggle-page-translation": {
      "suggested_key": {
        "windows": "Ctrl+Shift+L"
      },
      "description": "현재 페이지의 번역과 원문을 전환합니다."
    }
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["site-adapters.js", "content-helpers.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
