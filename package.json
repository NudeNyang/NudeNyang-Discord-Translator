{
  "name": "nude-translator-tauri",
  "private": true,
  "version": "0.7.4-beta",
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "test": "npm run test:web && npm run test:landing && npm run test:extension && npm run test:dictionaries",
    "test:web": "node --test web/test/*.test.mjs",
    "test:landing": "node --test landing/test/*.test.mjs",
    "test:extension": "node scripts/generate-extension-locales.mjs --check && node --test extension/test/*.test.mjs",
    "test:e2e": "node scripts/run-extension-e2e.mjs",
    "test:public": "node scripts/run-extension-e2e.mjs --public",
    "test:e2e:install": "node scripts/run-extension-e2e.mjs --install",
    "extension:locales": "node scripts/generate-extension-locales.mjs",
    "extension:personal": "npm run extension:locales && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package_personal_chromium_extension.ps1",
    "extension:chromium": "npm run extension:locales && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package_chromium_extension.ps1",
    "extension:firefox": "npm run extension:locales && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package_firefox_extension.ps1",
    "landing:locales": "node scripts/generate-landing-locales.mjs",
    "landing:serve": "node scripts/serve-landing.mjs",
    "test:locales": "node scripts/validate-ui-locales.mjs",
    "test:dictionaries": "node --test scripts/test/*.test.mjs && node scripts/validate-dictionary-packs.mjs",
    "dictionary:build": "node scripts/build-dictionary-pack.mjs",
    "dictionary:build:korean": "node scripts/build-krdict-pack.mjs",
    "dictionary:merge": "node scripts/merge-dictionary-packs.mjs",
    "dictionary:build:english": "node scripts/build-oewn-pack.mjs",
    "dictionary:build:chinese": "node scripts/build-cedict-pack.mjs",
    "dictionary:build:wiktionary": "node scripts/build-wiktionary-pack-set.mjs",
    "dictionary:sync:wiktionary": "node scripts/sync-wiktionary-pack-metadata.mjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build --no-bundle"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tauri-apps/cli": "^2.11.0",
    "jsdom": "30.0.1"
  }
}
