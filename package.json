{
  "name": "nude-translator-tauri",
  "private": true,
  "version": "0.6.1-beta",
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "test": "npm run test:web && npm run test:landing && npm run test:dictionaries",
    "test:web": "node --test web/test/*.test.mjs",
    "test:landing": "node --test landing/test/*.test.mjs",
    "landing:locales": "node scripts/generate-landing-locales.mjs",
    "landing:serve": "node scripts/serve-landing.mjs",
    "test:locales": "node scripts/validate-ui-locales.mjs",
    "test:dictionaries": "node --test scripts/test/*.test.mjs && node scripts/validate-dictionary-packs.mjs",
    "dictionary:build": "node scripts/build-dictionary-pack.mjs",
    "dictionary:build:korean": "node scripts/build-krdict-pack.mjs",
    "dictionary:merge": "node scripts/merge-dictionary-packs.mjs",
    "dictionary:build:english": "node scripts/build-oewn-pack.mjs",
    "dictionary:build:chinese": "node scripts/build-cedict-pack.mjs",
    "dictionary:build:wiktionary": "node scripts/build-wiktionary-pack-set.mjs",
    "dictionary:sync:wiktionary": "node scripts/sync-wiktionary-pack-metadata.mjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build --no-bundle"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.0"
  }
}
