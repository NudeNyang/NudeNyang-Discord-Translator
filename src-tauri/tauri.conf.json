{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nude Translator",
  "version": "0.3.0-beta",
  "identifier": "com.nudenyang.nudetranslator",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Nude Translator 설정",
        "width": 860,
        "height": 780,
        "minWidth": 640,
        "minHeight": 560,
        "resizable": true
      },
      {
        "label": "tray-menu",
        "title": "Nude Translator",
        "url": "tray.html",
        "width": 300,
        "height": 318,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "resources": [
      "../LICENSE",
      "../THIRD_PARTY_NOTICES.md",
      "../licenses"
    ],
    "icon": [
      "../assets/nude-translator.ico",
      "../assets/nude-translator.png"
    ]
  }
}
