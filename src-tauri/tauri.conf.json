{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nude Translator",
  "version": "0.3.1-beta",
  "identifier": "com.nudenyang.nudetranslator",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Nude Translator 설정",
        "width": 860,
        "height": 780,
        "minWidth": 640,
        "minHeight": 560,
        "resizable": true
      },
      {
        "label": "tray-menu",
        "title": "Nude Translator",
        "url": "tray.html",
        "width": 300,
        "height": 318,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "resources": {
      "../LICENSE": "LICENSE.txt",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../licenses/": "licenses/",
      "bundle-resources/runtime/": "runtime/"
    },
    "icon": [
      "../assets/nude-translator.ico",
      "../assets/nude-translator.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQzRUJCNzUwMUVEMjcyNTEKUldSUmN0SWVVTGZyUTI1eGpEWWVaVjc5M25sWHBsRlpJUlVwZUhzaS9qOEJRMHQrU0QwTitUWkMK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
