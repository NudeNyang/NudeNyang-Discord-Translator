{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "NudeNyang Translator main window permissions",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "autostart:allow-is-enabled",
    "autostart:allow-enable",
    "autostart:allow-disable",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://x.com/NudeNyang_VRC" },
        { "url": "https://github.com/NudeNyang/NudeNyang-Translator" },
        { "url": "https://github.com/NudeNyang/NudeNyang-Translator/releases/**" }
      ]
    }
  ]
}
