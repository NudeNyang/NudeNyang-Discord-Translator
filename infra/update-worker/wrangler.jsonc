{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nude-translator-beta-updates",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-09",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "r2_buckets": [
    {
      "binding": "RELEASES",
      "bucket_name": "nude-translator-beta-releases"
    }
  ]
}
