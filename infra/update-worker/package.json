{
  "name": "nude-translator-update-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "types": "wrangler types --env-file .dev.vars.example",
    "typecheck": "npm run types && tsc --noEmit",
    "test": "tsx --test test/*.test.mjs",
    "check": "npm run typecheck && npm test && wrangler deploy --dry-run",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@types/node": "^24.2.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "wrangler": "^4.120.0"
  }
}
